# Open Data API
TRUDVSEM_API_URL=https://opendata.trudvsem.ru/api/v1/vacancies/region/39

# Регион
REGION_CODE=39

# Пагинация
PAGE_SIZE=100
MAX_PAGES=2

# HTTP настройки
HTTP_TIMEOUT=30
REQUEST_PAUSE=0.4

# Пути к отчетам
REPORT_PATH=reports/report.json
BACKUP_PATH=reports/last_successful_report.json

# AI модель (Ollama)
OLLAMA_URL=http://localhost:11434/api/chat
OLLAMA_MODEL=qwen2.5:3b
AI_ENABLED=true

# Логирование
LOG_LEVEL=INFO
